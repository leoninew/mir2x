{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_id",
    "map_name",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "map_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "map_name": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monster_id",
          "monster_name",
          "loc"
        ],
        "properties": {
          "monster_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "monster_name": {
            "type": "string",
            "minLength": 1
          },
          "loc": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "w",
                "h",
                "count",
                "time"
              ],
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "y": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "time": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "cratio": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            }
          }
        }
      }
    }
  }
}

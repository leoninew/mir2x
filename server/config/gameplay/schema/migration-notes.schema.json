{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_revision",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "source_path",
          "source_position",
          "raw",
          "reason"
        ],
        "properties": {
          "domain": {
            "enum": [
              "drops",
              "spawns"
            ]
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "raw": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

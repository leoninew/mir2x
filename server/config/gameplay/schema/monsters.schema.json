{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "monsters"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "monsters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monster_id",
          "monster_name",
          "exp"
        ],
        "properties": {
          "monster_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "monster_name": {
            "type": "string",
            "minLength": 1
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    }
  }
}

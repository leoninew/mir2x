{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "drop_monsters",
    "spawn_maps"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "drop_monsters": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      },
      "uniqueItems": true
    },
    "spawn_maps": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      },
      "uniqueItems": true
    }
  }
}

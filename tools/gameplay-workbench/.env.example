# Copy to .env.<profile>; select it with profile=<profile> or MIR2X_WORKBENCH_PROFILE.
MIR2X_WORKBENCH_GREETING__PREFIX=Hello
MIR2X_WORKBENCH_SERVER__HOST=127.0.0.1
MIR2X_WORKBENCH_SERVER__PORT=8000
MIR2X_WORKBENCH_SERVER__RELOAD=false
MIR2X_WORKBENCH_DESKTOP__TITLE=Example Desktop
MIR2X_WORKBENCH_DESKTOP__WIDTH=1200
MIR2X_WORKBENCH_DESKTOP__HEIGHT=800
MIR2X_WORKBENCH_DESKTOP__MIN_WIDTH=800
MIR2X_WORKBENCH_DESKTOP__MIN_HEIGHT=600
MIR2X_WORKBENCH_DESKTOP__DEBUG=false
MIR2X_WORKBENCH_DESKTOP__FRONTEND_URL=http://localhost:8081
MIR2X_WORKBENCH_STATIC__DIRECTORY=./static
